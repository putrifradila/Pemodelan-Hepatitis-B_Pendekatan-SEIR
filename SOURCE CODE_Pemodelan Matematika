%% Source Code Simulasi Subpopulasi Exposed
% MATLAB code for plotting
clc;
clear;
% Parameter
t = linspace(0, 30, 1000); % Waktu (bulan)
N0 = 3e4; % Jumlah awal individu yang menunjukkan gejala
t_peak = 5; % Waktu puncak gejala (bulan)
sigma = 3; % Penyebaran atau deviasi standar (bulan)
% Fungsi distribusi individu yang menunjukkan gejala
N = N0 * exp(-((t - t_peak).^2) / (2 * sigma^2));
% Plot grafik
figure;
plot(t, N, 'b', 'LineWidth', 1);
grid on;
% Pengaturan axis
xlabel('Waktu (bulan)');
ylabel('Jumlah individu yang memperlihatkan gejala');
title('Grafik Penyebaran Penyakit Hepatitis');
% Pengaturan skala
ylim([0, 3.5e4]);
xlim([0, 30]);
