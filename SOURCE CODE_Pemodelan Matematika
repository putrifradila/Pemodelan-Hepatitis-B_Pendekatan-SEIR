%% Source Code Simulasi Subpopulasi Recovered
% Parameter simulasi
waktu = linspace(0, 30, 100); % Waktu dalam bulan
a = 100; % Amplitudo (maksimum jumlah individu sembuh)
b = 15; % Lokasi puncak
c = 10; % Lebar distribusi
% Model pemulihan (contoh kurva Gaussian terbalik)
jumlah_sembuh = a * exp(-((waktu - b).^2) / (2 * c^2)) + 40; % Menyesuaikan dengan nilai minimum
% Plot grafik
figure;
plot(waktu, jumlah_sembuh, 'y', 'LineWidth', 1.5);
title('Grafik Penyebaran Penyakit Hepatitis');
xlabel('Waktu (bulan)');
ylabel('Jumlah individu yang telah sembuh');
grid on;
% Sesuaikan tampilan
set(gca, 'FontSize', 12);
