%% Simulasi Subpopulasi Susceptible
% MATLAB code for plotting
clc;
clear;
% Parameter
t = linspace(0, 30, 1000); % Waktu (bulan)
N0 = 3.5e4; % Populasi awal individu yang berpotensi terinfeksi
k = 1; % Laju penurunan
% Fungsi distribusi individu yang berpotensi terinfeksi
N = N0 * exp(-k * t);
% Plot grafik
figure;
plot(t, N, 'g', 'LineWidth', 1);
grid on;
% Pengaturan axis
xlabel('Waktu (bulan)');
ylabel('Jumlah individu yang berpotensi terinfeksi');
title('Grafik Penyebaran Penyakit Hepatitis');
% Pengaturan skala
ylim([0, 4e4]);
xlim([0, 30]);
