%% Source Code Simulasi Subpopulasi Infected
% MATLAB code for plotting
clc;
clear;
% Parameter
t = linspace(0, 30, 1000); % Waktu (bulan)
N0 = 40; % Populasi awal individu terinfeksi
Nmax = 140; % Puncak jumlah individu yang terinfeksi
t_peak = 6; % Waktu puncak infeksi (bulan)
sigma = 5; % Parameter penyebaran waktu (deviasi standar)
% Fungsi jumlah individu yang telah terinfeksi
N = N0 + (Nmax - N0) * exp(-((t - t_peak).^2) / (2 * sigma^2));
% Plot grafik
figure;
plot(t, N, 'r', 'LineWidth', 1);
grid on;
% Pengaturan axis
xlabel('Waktu (bulan)');
ylabel('Jumlah individu yang telah terinfeksi');
title('Grafik Penyebaran Penyakit Hepatitis');
% Pengaturan skala
ylim([20, 160]);
xlim([0, 30]);
